{
  "name": "@beyonk/svelte-datepicker",
  "version": "13.0.5",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-package",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "packageManager": "pnpm@12.9.1",
  "repository": "https://github.com/beyonk/svelte-datepicker.git",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "dayjs": "^1.11.9"
  },
  "type": "module",
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@beyonk/eslint-config": "^10.1.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^9.39.5",
    "mockdate": "^3.0.5",
    "pkg-pr-new": "^0.0.88",
    "svelte": "^5.57.1",
    "svelte2tsx": "^0.7.61",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
